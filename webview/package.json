{
  "name": "ui-review-webview",
  "private": true,
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --outfile=../vscode-extension/dist/webview.js --format=iife --jsx=automatic --platform=browser",
